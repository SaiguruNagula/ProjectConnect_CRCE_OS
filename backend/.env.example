# Copy to .env and fill in real values. NEVER commit .env.
ENV=development
DEBUG=false

# Identifies this installation (one college = one deployment, ADR-9).
# Required when ENV=production. Nothing is transmitted anywhere.
DEPLOYMENT_ID=local-dev

# PostgreSQL connection (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/projectconnect
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-generated-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Account lockout after this many consecutive failed logins
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
