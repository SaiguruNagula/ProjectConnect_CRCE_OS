# Copy to .env for docker compose. NEVER commit .env.
POSTGRES_DB=projectconnect
POSTGRES_USER=projectconnect
POSTGRES_PASSWORD=

ENV=production
# Identifies this installation (one college = one deployment). Any stable
# string; nothing is sent anywhere. Example: crce-prod-01
DEPLOYMENT_ID=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
CORS_ORIGINS=http://localhost
